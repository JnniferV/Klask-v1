<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Bilan de Groupe - KLASK</title>
    <style>
        body { font-family: Arial, sans-serif; color: #333; margin: 0; padding: 20px; }
        .header { text-align: center; border-bottom: 2px solid #8B0000; padding-bottom: 15px; margin-bottom: 25px; }
        .header h1 { color: #8B0000; margin: 0 0 5px 0; text-transform: uppercase; }
        .header p { margin: 3px 0; color: #555; font-size: 14px; }
        .summary-card { background-color: #f9f9f9; border: 1px solid #ddd; padding: 15px; text-align: center; border-radius: 5px; }
        .summary-card h3 { margin: 0 0 5px 0; font-size: 14px; color: #555; }
        .summary-card .value { font-size: 24px; font-weight: bold; color: #27ae60; }
        h2 { color: #8B0000; font-size: 16px; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-top: 25px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
        th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; }
        th { background-color: #f1f1f1; color: #444; }
    </style>
</head>
<body>

<div class="header">
    <h1>BILAN D'ÉQUIPE AJE29 — KLASK</h1>
    <p>Groupe : <strong>{{ bilan.group }}</strong></p>
    <p>Accompagnateur : <strong>{{ accompanying.pseudo ?? accompanying.email }}</strong></p>
    <p>Nombre d'élèves : <strong>{{ bilan.studentsCount }}</strong></p>
</div>

<table style="width: 100%; margin-bottom: 25px;">
    <tr>
        <td style="width: 50%; border: none; padding-right: 10px;">
            <div class="summary-card">
                <h3>Score collectif total</h3>
                <div class="value">{{ bilan.totalScore }} pts</div>
            </div>
        </td>
        <td style="width: 50%; border: none; padding-left: 10px;">
            <div class="summary-card">
                <h3>Volume de visites</h3>
                <div class="value">{{ bilan.totalScans }} stands</div>
            </div>
        </td>
    </tr>
</table>

<h2>Répartition par sphère d'activité</h2>
{% if bilan.spheresStats is empty %}
    <p style="color: #777; font-style: italic;">Aucun stand visité pour le moment.</p>
{% else %}
    <table>
        <thead>
        <tr>
            <th>Sphère</th>
            <th>Nombre de stands validés</th>
        </tr>
        </thead>
        <tbody>
        {% for sphereName, count in bilan.spheresStats %}
            <tr>
                <td><strong>{{ sphereName }}</strong></td>
                <td>{{ count }} visite(s)</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<h2>Stands les plus visités par le groupe</h2>
{% if bilan.activitiesStats is empty %}
    <p style="color: #777; font-style: italic;">Aucune activité enregistrée.</p>
{% else %}
    <table>
        <thead>
        <tr>
            <th>Stand / Activité</th>
            <th>Catégorie</th>
            <th>Visites du groupe</th>
        </tr>
        </thead>
        <tbody>
        {% for activityName, stats in bilan.activitiesStats %}
            <tr>
                <td><strong>{{ activityName }}</strong></td>
                <td>{{ stats.category }}</td>
                <td>{{ stats.count }} élève(s)</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

</body>
</html>
