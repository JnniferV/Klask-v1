{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Statistiques{% endblock %}

{% block main %}
<div class="row g-4">

    {# ── KPI global ── #}
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="fs-1">📊</span>
                <div>
                    <div class="fs-5 fw-bold">{{ totalScans }} scan{{ totalScans > 1 ? 's' : '' }} validé{{ totalScans > 1 ? 's' : '' }}</div>
                    <div class="text-muted small">Total cumulé depuis le début de l'event</div>
                </div>
            </div>
        </div>
    </div>

    {# ── Top 5 groupes ── #}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">🏆 Top 5 Groupes</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Groupe</th><th>Élèves</th><th class="text-end">Score</th></tr>
                    </thead>
                    <tbody>
                    {% for g in topGroups %}
                        <tr{% if loop.index == 1 %} class="table-warning fw-bold"{% endif %}>
                            <td>{{ loop.index }}</td>
                            <td>{{ g.name }} <small class="text-muted">({{ g.code }})</small></td>
                            <td>{{ g.studentCount }}</td>
                            <td class="text-end">{{ g.score }} pts</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3">Aucun groupe</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Sphères les plus visitées ── #}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">🌐 Sphères les plus visitées</div>
            <div class="card-body">
                {# Déjà trié par visites décroissantes : la 1re ligne EST le maximum #}
                {% set maxVisits = sphereVisits ? (sphereVisits|first).visits : 1 %}
                {% for s in sphereVisits %}
                <div class="mb-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>{{ s.sphere }}</span>
                        <span class="fw-bold">{{ s.visits }} scan{{ s.visits > 1 ? 's' : '' }}</span>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-primary" style="width:{{ (s.visits / maxVisits * 100)|round }}%"></div>
                    </div>
                </div>
                {% else %}
                    <p class="text-muted text-center mt-3">Aucun scan enregistré</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ── Top 10 élèves ── #}
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold">🎓 Top 10 Élèves</div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Pseudo</th><th>Groupe</th><th>Scans</th><th class="text-end">Score</th></tr>
                    </thead>
                    <tbody>
                    {% for u in topStudents %}
                        <tr{% if loop.index <= 3 %} class="{{ loop.index == 1 ? 'table-warning' : 'table-light' }} fw-semibold"{% endif %}>
                            <td>
                                {% if loop.index == 1 %}🥇
                                {% elseif loop.index == 2 %}🥈
                                {% elseif loop.index == 3 %}🥉
                                {% else %}{{ loop.index }}{% endif %}
                            </td>
                            <td>{{ u.pseudo }}</td>
                            <td class="text-muted">{{ u.groupName ?? '—' }}</td>
                            <td>{{ u.scanCount }}</td>
                            <td class="text-end fw-bold">{{ u.score }} pts</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-3">Aucun élève inscrit</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
