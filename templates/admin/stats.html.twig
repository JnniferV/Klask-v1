{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Statistiques{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_stats') }}" class="btn btn-secondary">
        <i class="fa fa-refresh"></i> Actualiser (HTML)
    </a>
    <a href="{{ path('admin_stats_pdf') }}" class="btn btn-primary">
        <i class="fa fa-file-pdf-o"></i> Exporter en PDF
    </a>
{% endblock %}

{% block main %}
<div class="row g-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="fs-1">📊</span>
                <div>
                    <div class="fs-5 fw-bold">{{ totalScans }} scan{{ totalScans > 1 ? 's' : '' }} validé{{ totalScans > 1 ? 's' : '' }}</div>
                    <div class="text-muted small">Total cumulé depuis le début de l'event</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="fs-1">💼</span>
                <div>
                    <div class="fs-5 fw-bold">{{ internshipScans }} demande{{ internshipScans > 1 ? 's' : '' }} de stage</div>
                    <div class="text-muted small">Scans sur stands marqués « Stage »</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">🏆 Top 5 Groupes</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Groupe</th><th>Élèves</th><th class="text-end">Score</th></tr>
                    </thead>
                    <tbody>
                    {% for g in topGroups %}
                        <tr{% if loop.index == 1 %} class="table-warning fw-bold"{% endif %}>
                            <td>{{ loop.index }}</td>
                            <td>{{ g.name }} <small class="text-muted">({{ g.code }})</small></td>
                            <td>{{ g.studentCount }}</td>
                            <td class="text-end">{{ g.score }} pts</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3">Aucun groupe</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">🌐 Sphères les plus visitées</div>
            <div class="card-body">
                {# déjà trié desc #}
                {% set maxVisits = sphereVisits ? (sphereVisits|first).visits : 1 %}
                {% for s in sphereVisits %}
                <div class="mb-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>{{ s.sphere }}</span>
                        <span class="fw-bold">{{ s.visits }} scan{{ s.visits > 1 ? 's' : '' }}</span>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-primary" style="width:{{ (s.visits / maxVisits * 100)|round }}%"></div>
                    </div>
                </div>
                {% else %}
                    <p class="text-muted text-center mt-3">Aucun scan enregistré</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">⭐ Top 10 Stands visités</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Stand / Activité</th><th class="text-end">Scans</th></tr>
                    </thead>
                    <tbody>
                    {% for a in topActivities %}
                        <tr>
                            <td>{{ a.activity }}</td>
                            <td class="text-end fw-bold">{{ a.visits }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2" class="text-center text-muted py-3">Aucun scan enregistré</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold">🎓 Élèves par niveau / établissement</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Établissement</th><th>Niveau</th><th class="text-end">Effectif</th></tr>
                    </thead>
                    <tbody>
                    {% set totalStudents = 0 %}
                    {% for row in studentsByLevel %}
                        {% set totalStudents = totalStudents + row.students %}
                        <tr>
                            <td>{{ row.establishment }}</td>
                            <td class="text-muted">{{ row.level }}</td>
                            <td class="text-end fw-bold">{{ row.students }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-center text-muted py-3">Aucun élève inscrit</td></tr>
                    {% endfor %}
                    </tbody>
                    {% if studentsByLevel %}
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2" class="text-end fw-bold">Total</td>
                            <td class="text-end fw-bold text-success">{{ totalStudents }}</td>
                        </tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold">🎓 Top 10 Élèves</div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Pseudo</th><th>Groupe</th><th>Scans</th><th class="text-end">Score</th></tr>
                    </thead>
                    <tbody>
                    {% for u in topStudents %}
                        <tr{% if loop.index <= 3 %} class="{{ loop.index == 1 ? 'table-warning' : 'table-light' }} fw-semibold"{% endif %}>
                            <td>
                                {% if loop.index == 1 %}🥇
                                {% elseif loop.index == 2 %}🥈
                                {% elseif loop.index == 3 %}🥉
                                {% else %}{{ loop.index }}{% endif %}
                            </td>
                            <td>{{ u.pseudo }}</td>
                            <td class="text-muted">{{ u.groupName ?? '—' }}</td>
                            <td>{{ u.scanCount }}</td>
                            <td class="text-end fw-bold">{{ u.score }} pts</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-3">Aucun élève inscrit</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
