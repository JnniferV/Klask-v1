<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Scan — Klask</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { min-height: 100dvh; display: flex; align-items: center; justify-content: center;
         background: #0f0f1a; font-family: system-ui, sans-serif; color: #fff; }
  .card { text-align: center; padding: 2.5rem 2rem; max-width: 320px; width: 90%; }
  .icon { font-size: 4rem; margin-bottom: 1rem; }
  .pts  { font-size: 2.8rem; font-weight: 900; color: #00b894; letter-spacing: -1px; }
  .name { font-size: 1.1rem; color: #b2bec3; margin: .4rem 0 1.6rem; }
  .err  { font-size: 1.1rem; color: #e17055; margin-bottom: 1.6rem; }
  .btn  { display: inline-block; padding: .85rem 2rem; background: #6c5ce7; color: #fff;
          border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 1rem; }
  .hint { font-size: .78rem; color: #636e72; margin-top: 1rem; }
</style>
</head>
<body>
<div class="card">
  {% if ok %}
    <div class="icon">✅</div>
    {# Total réellement crédité au score — le bonus doit être visible, sinon l'écart paraît incohérent #}
    <div class="pts">+{{ points + bonus }} pts</div>
    <div class="name">{{ activityName }}{% if bonus %} · dont {{ bonus }} pts bonus 🎉{% endif %}</div>
  {% else %}
    <div class="icon">❌</div>
    <div class="err">{{ error }}</div>
  {% endif %}
  <a href="{{ redirect }}" class="btn">{{ ok ? 'Retour à la carte' : 'Continuer' }}</a>
  <p class="hint">Redirection automatique dans <span id="c">3</span>s…</p>
</div>
<script>
  let n = 3;
  const t = setInterval(() => { document.getElementById('c').textContent = --n; if (n <= 0) { clearInterval(t); location.replace({{ redirect|json_encode|raw }}); } }, 1000);
</script>
</body>
</html>
